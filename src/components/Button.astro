---
import { BUTTON_BASE, BUTTON_SIZES } from '../lib/button-styles';
import Link from './Link.astro';

interface Props {
  href?: string;
  size?: 'sm' | 'md' | 'lg';
  variant?: 'primary' | 'secondary';
  class?: string;
  /** Open in a new tab (default: web links only; see Link). */
  newTab?: boolean;
  type?: string;
  'data-testid'?: string;
}

const {
  href,
  size = 'md',
  variant = 'primary',
  class: className = '',
  newTab,
  type,
  'data-testid': testId,
  ...rest
} = Astro.props;

const baseStyles = `${BUTTON_BASE} border-green-accent text-green-accent hover:bg-green-tint focus:bg-green-tint disabled:opacity-50 disabled:cursor-not-allowed`;

const variantMap: Record<string, string> = {
  primary: 'text-green-accent border-green-accent hover:bg-green-tint',
  secondary: 'text-light-slate border-light-slate hover:bg-lightest-navy/10',
};

const classes = `${baseStyles} ${BUTTON_SIZES[size]} ${variantMap[variant]} ${className}`;

---

{href ? (
  <Link href={href} newTab={newTab} class={classes} data-testid={testId} {...rest}>
    <slot />
  </Link>
) : (
  <button type={type || 'button'} class={classes} data-testid={testId} {...rest}>
    <slot />
  </button>
)}
