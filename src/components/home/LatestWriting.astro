---
import type { CollectionEntry } from 'astro:content';
import RevealGroup from '../motion/RevealGroup.tsx';
import SectionHeading from './SectionHeading.tsx';
import ArticleRow from '../ArticleRow.astro';
import { GUTTER } from '../../lib/layout';
import { TAP_LINK } from '../../lib/text-styles';

interface Props { articles: CollectionEntry<'articles'>[]; }
const { articles } = Astro.props;
---

<section id="writing" class={`border-t border-graphite pb-14 pt-16 ${GUTTER}`}>
  <div class="mb-[22px] flex items-end justify-between">
    <SectionHeading number="03" className="m-0">Latest Writing</SectionHeading>
    <a href="/insights/" class={`${TAP_LINK} -my-3 shrink-0 font-mono text-[13px] text-green-accent no-underline hover:underline`}>All writing →</a>
  </div>
  <RevealGroup client:load selector=".reveal">
    <ul class="m-0 list-none border-t border-light-graphite p-0">
      {articles.map((a) => <ArticleRow article={a} class="reveal" />)}
    </ul>
  </RevealGroup>
</section>
