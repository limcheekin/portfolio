---
import type { CollectionEntry } from 'astro:content';
import RevealGroup from '../motion/RevealGroup.tsx';
import SectionHeading from './SectionHeading.tsx';
import { GUTTER } from '../../lib/layout';

interface Props { articles: CollectionEntry<'articles'>[]; }
const { articles } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
// Hover: the row nudges right, a green tint fades in, the title turns green and the arrow lifts.
// Only transforms, opacity and colour transition; the movement is off under reduced motion.
const HOVER_EASE = 'duration-300 ease-out motion-reduce:transition-none';
---

<section id="writing" class={`border-t border-graphite pb-14 pt-16 ${GUTTER}`}>
  <div class="mb-[22px] flex items-end justify-between">
    <SectionHeading number="03" className="m-0">Latest Writing</SectionHeading>
    <a href="/insights/" class="font-mono text-[13px] text-green-accent no-underline">All writing →</a>
  </div>
  <RevealGroup client:load selector=".reveal">
    <ul class="m-0 list-none border-t border-light-graphite p-0">
      {articles.map((a) => {
        const external = !!a.data.externalUrl;
        return (
          <li class="reveal group relative border-b border-light-graphite">
            <span aria-hidden="true" class={`pointer-events-none absolute inset-0 bg-row-tint opacity-0 transition-opacity group-hover:opacity-100 ${HOVER_EASE}`}></span>
            <a
              href={external ? a.data.externalUrl : `/insights/${a.slug}/`}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              class={`relative grid grid-cols-[1fr_20px] items-center gap-5 px-1 py-5 text-inherit no-underline transition-transform motion-safe:group-hover:translate-x-[14px] md:grid-cols-[90px_1fr_auto_24px] ${HOVER_EASE}`}
            >
              <span class="hidden font-mono text-xs text-slate-text md:block">{fmt(a.data.publishDate)}</span>
              <span class={`text-lg tracking-[-0.01em] text-lightest-slate transition-colors group-hover:text-green-accent ${HOVER_EASE}`}>{a.data.title}</span>
              <span class="hidden font-mono text-xs text-slate-text md:block">{a.data.tags.slice(0, 2).join(' · ')}</span>
              <span
                class={`inline-block text-slate-text transition-[transform,color] group-hover:text-green-accent motion-safe:group-hover:translate-x-[3px] motion-safe:group-hover:-translate-y-[3px] ${HOVER_EASE}`}
                aria-hidden="true"
              >↗</span>
            </a>
          </li>
        );
      })}
    </ul>
  </RevealGroup>
</section>
