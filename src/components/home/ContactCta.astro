---
import { CONTACT_CTA, CONTACT_LINKS, HERO_CONTENT } from '../../data/site';
import MagnetButton from './MagnetButton.tsx';
import { GUTTER } from '../../lib/layout';
import { TAP_LINK } from '../../lib/text-styles';
import Link from '../Link.astro';

const LINK = `${TAP_LINK} text-light-slate no-underline hover:text-green-accent`;
---

<section
  id="contact"
  aria-labelledby="contact-title"
  class={`relative flex min-h-[90vh] flex-col items-center justify-center overflow-hidden border-t border-graphite py-[10vh] text-center ${GUTTER}`}
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-[60%] h-[900px] w-[900px] max-w-[160vw] -translate-x-1/2 -translate-y-1/2 bg-contact-glow"
  ></div>
  <p class="relative mb-[22px] font-mono text-[13px] text-green-accent">{CONTACT_CTA.eyebrow}</p>
  <h2 id="contact-title" class="relative m-0 max-w-[900px] text-[clamp(36px,6vw,76px)] font-semibold leading-[1.04] tracking-[-0.035em] text-lightest-slate">
    {CONTACT_CTA.headline.before}<em class="not-italic text-green-accent">{CONTACT_CTA.headline.accent}</em>
  </h2>
  <p class="relative mb-[44px] mt-6 max-w-[520px] text-lg leading-relaxed text-slate-text">{CONTACT_CTA.paragraph}</p>
  <div class="relative">
    <MagnetButton client:visible href={CONTACT_CTA.button.href} label={CONTACT_CTA.button.label} />
  </div>
  <ul class="relative mt-[22px] flex list-none flex-wrap justify-center gap-x-[26px] p-0 font-mono text-[13px]">
    {CONTACT_LINKS.map((l) => (
      <li><Link href={l.url} data-testid={`contact-link-${l.name.toLowerCase()}`} class={LINK}>{l.name}</Link></li>
    ))}
    <li><Link href={HERO_CONTENT.resumeCta.href} newTab data-testid="contact-link-resume" class={LINK}>{HERO_CONTENT.resumeCta.label}</Link></li>
  </ul>
</section>
