---
import { CONTACT_CTA, SOCIAL_LINKS } from '../../data/site';
import MagnetButton from './MagnetButton.tsx';
---

<section
  id="contact"
  class="relative flex min-h-[90vh] flex-col items-center justify-center overflow-hidden border-t border-[#141417] px-[6vw] py-[10vh] text-center"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-[60%] h-[900px] w-[900px] max-w-[160vw] -translate-x-1/2 -translate-y-1/2"
    style="background: radial-gradient(circle, rgba(0,217,146,.10), transparent 60%);"
  ></div>
  <p class="relative mb-[22px] font-mono text-[13px] text-green-accent">{CONTACT_CTA.eyebrow}</p>
  <h2 class="relative m-0 max-w-[900px] text-[clamp(36px,6vw,76px)] font-semibold leading-[1.04] tracking-[-0.035em] text-lightest-slate">
    {CONTACT_CTA.headline.before}<em class="not-italic text-green-accent">{CONTACT_CTA.headline.accent}</em>
  </h2>
  <p class="relative mb-[44px] mt-6 max-w-[520px] text-[17px] leading-[1.55] text-slate-text">{CONTACT_CTA.paragraph}</p>
  <div class="relative">
    <MagnetButton client:visible href={CONTACT_CTA.button.href} label={CONTACT_CTA.button.label} />
  </div>
  <ul class="relative mt-[34px] flex list-none flex-wrap justify-center gap-x-[26px] gap-y-2 p-0 font-mono text-[13px]">
    {SOCIAL_LINKS.map((l) => (
      <li><a href={l.url} target="_blank" rel="noopener noreferrer" class="text-light-slate no-underline hover:text-green-accent">{l.name}</a></li>
    ))}
    <li><a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="text-light-slate no-underline hover:text-green-accent">Résumé ↗</a></li>
  </ul>
</section>
