---
import type { CollectionEntry } from 'astro:content';
import { CHIP, MEASURE } from '../lib/text-styles';

/** Full work history on About, drawn like the home Career rail: one line, a green-ringed dot per role. */
interface Props {
  entries: CollectionEntry<'experience'>[];
}

const { entries } = Astro.props;
---

<div class="relative pl-[34px]">
  <div aria-hidden="true" class="absolute bottom-1.5 left-1.5 top-1.5 w-0.5 bg-light-graphite"></div>
  <ol class="m-0 list-none space-y-12 p-0">
    {entries.map((exp) => (
      <li class="relative">
        <span aria-hidden="true" class="absolute -left-[34px] top-1.5 h-3.5 w-3.5 rounded-full border-2 border-green-accent bg-navy shadow-halo"></span>
        <p class="font-mono text-xs tracking-wide text-green-accent">{exp.data.startDate} – {exp.data.endDate || 'Present'}</p>
        <h3 class="mt-1.5 text-xl font-semibold tracking-[-0.02em] text-lightest-slate">
          {exp.data.title}
          {exp.data.companyUrl ? (
            <a href={exp.data.companyUrl} target="_blank" rel="noopener noreferrer" class="text-green-accent hover:underline">
              {' '}@ {exp.data.company}<span class="sr-only"> (opens in a new tab)</span>
            </a>
          ) : (
            <span class="text-green-accent"> @ {exp.data.company}</span>
          )}
        </h3>
        <ul class={`mt-3 ${MEASURE} list-none space-y-1.5 pl-0 text-sm leading-relaxed text-slate-text`}>
          {exp.data.description.map((point) => (
            <li class="relative pl-5 before:absolute before:left-0 before:text-slate-text before:opacity-70 before:content-['–']">
              {point}
            </li>
          ))}
        </ul>
        {exp.data.technologies.length > 0 && (
          <ul class="mt-4 flex list-none flex-wrap gap-2 p-0">
            {exp.data.technologies.map((skill) => (
              <li class={CHIP}>{skill}</li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ol>
</div>
