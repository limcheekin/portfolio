---
import type { CollectionEntry } from 'astro:content';
import { MEASURE, TAP_LINK } from '../lib/text-styles';
import { articlePath } from '../lib/paths';

/**
 * One article as a list row (Latest Writing on home, and the Writing page): date, title, two tags, arrow.
 * Hover: the row nudges right, a green tint fades in, the title turns green and the arrow lifts. Only
 * transforms, opacity and colour transition; the movement is off under reduced motion.
 */
interface Props {
  article: CollectionEntry<'articles'>;
  /** Extra classes on the <li> (e.g. the scroll-reveal hook). */
  class?: string;
  /** Render the title as an h2 (h3 otherwise, under the home section heading) and show the description under it (Writing page). */
  detailed?: boolean;
}

const { article, class: className = '', detailed = false } = Astro.props;
const { title, description, publishDate, tags, externalUrl, platform } = article.data;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const HOVER_EASE = 'duration-300 ease-out motion-reduce:transition-none';
const Title = detailed ? 'h2' : 'h3';
---

<li data-testid="article-row" data-slug={article.slug} class={`group relative border-b border-light-graphite ${className}`}>
  <span aria-hidden="true" class={`pointer-events-none absolute inset-0 bg-row-tint opacity-0 transition-opacity group-hover:opacity-100 ${HOVER_EASE}`}></span>
  <!-- Each child is placed explicitly: on phones the date (Writing page only) drops under the title, so it is
       rendered once, as one <time>, in both layouts. -->
  <a
    href={externalUrl ?? articlePath(article.slug)}
    target={externalUrl ? '_blank' : undefined}
    rel={externalUrl ? 'noopener noreferrer' : undefined}
    data-testid="article-link"
    class={`relative grid grid-cols-[1fr_20px] items-center gap-x-5 gap-y-2 px-1 py-5 text-inherit no-underline transition-transform motion-safe:group-hover:translate-x-[14px] md:grid-cols-[90px_1fr_auto_24px] ${HOVER_EASE}`}
  >
    <time
      datetime={publishDate.toISOString()}
      class={`col-start-1 row-start-2 font-mono text-xs text-slate-text md:row-start-1 md:block ${detailed ? 'block' : 'hidden'}`}
    >{fmt(publishDate)}</time>
    <div class="col-start-1 row-start-1 min-w-0 md:col-start-2">
      <Title class={`block text-lg tracking-[-0.01em] text-lightest-slate transition-colors group-hover:text-green-accent ${HOVER_EASE}`}>{title}</Title>
      {detailed && <span class={`mt-1 block ${MEASURE} text-sm leading-relaxed text-slate-text`}>{description}</span>}
    </div>
    <span class="hidden font-mono text-xs text-slate-text md:col-start-3 md:row-start-1 md:block">{tags.slice(0, 2).join(' · ')}</span>
    <span
      class={`col-start-2 row-start-1 inline-block text-slate-text transition-[transform,color] group-hover:text-green-accent motion-safe:group-hover:translate-x-[3px] motion-safe:group-hover:-translate-y-[3px] md:col-start-4 ${HOVER_EASE}`}
      aria-hidden="true"
    >↗</span>
    {externalUrl && <span class="sr-only">{`(opens on ${platform ?? 'an external site'} in a new tab)`}</span>}
  </a>
  {detailed && externalUrl && (
    <a
      href={articlePath(article.slug)}
      data-testid="article-summary-link"
      class={`${TAP_LINK} relative -mt-3 mb-2 ml-1 font-mono text-xs text-slate-text transition-colors hover:text-green-accent md:ml-[111px] ${HOVER_EASE}`}
    >Summary on this site<span class="sr-only">: {title}</span> →</a>
  )}
</li>
