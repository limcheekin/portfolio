---
import Button from './Button.astro';
import { SITE_URL } from '../data/site';
const FORMSPREE_ENDPOINT = "https://formspree.io/f/xzdyblya";

const FIELD =
  'w-full bg-card border border-edge rounded px-4 py-3 text-sm text-lightest-slate placeholder-slate-text transition-colors duration-250 focus:border-green-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-green-accent/50 aria-[invalid=true]:border-danger';
const LABEL = 'block font-mono text-xs text-light-slate mb-1.5';
const ERROR = 'hidden font-mono text-xs text-danger mt-1.5';
---

<!-- novalidate: the script below runs the checks and shows inline errors instead of the browser's bubbles.
     Without JavaScript the form still posts and Formspree validates. -->
<form
  action={FORMSPREE_ENDPOINT}
  method="POST"
  data-testid="contact-form"
  class="w-full max-w-lg text-left mb-8 space-y-5"
  novalidate
>
  <div>
    <label for="contact-name" class={LABEL}>Name</label>
    <input
      type="text"
      id="contact-name"
      name="name"
      required
      autocomplete="name"
      minlength="2"
      pattern=".{2,}"
      data-testid="contact-field-name"
      aria-describedby="contact-name-error"
      class={FIELD}
      placeholder="Your name"
    />
    <p id="contact-name-error" class={ERROR}></p>
  </div>
  <div>
    <label for="contact-email" class={LABEL}>Email</label>
    <input
      type="email"
      id="contact-email"
      name="email"
      required
      autocomplete="email"
      data-testid="contact-field-email"
      aria-describedby="contact-email-error"
      class={FIELD}
      placeholder="your@email.com"
    />
    <p id="contact-email-error" class={ERROR}></p>
  </div>
  <div>
    <label for="contact-message" class={LABEL}>Message</label>
    <textarea
      id="contact-message"
      name="message"
      required
      rows="5"
      minlength="10"
      data-testid="contact-field-message"
      aria-describedby="contact-message-error"
      class={`${FIELD} resize-y`}
      placeholder="What would you like to discuss?"
    ></textarea>
    <p id="contact-message-error" class={ERROR}></p>
  </div>
  <!-- Formspree expects an absolute redirect URL. -->
  <input type="hidden" name="_next" value={`${SITE_URL}/contact/?submitted=true`} />
  <div class="text-center pt-2">
    <Button type="submit" size="lg" data-testid="contact-form-submit">Send Message</Button>
  </div>
</form>

<script>
  type Field = HTMLInputElement | HTMLTextAreaElement;

  // Each message names the problem and how to fix it.
  const MESSAGES: Record<string, (f: Field) => string> = {
    'contact-name': (f) => (f.validity.valueMissing ? 'Enter your name.' : 'Your name needs at least 2 characters.'),
    'contact-email': (f) => (f.validity.valueMissing ? 'Enter your email address.' : 'Enter a valid email address, like name@example.com.'),
    'contact-message': (f) => (f.validity.valueMissing ? 'Tell me what you would like to discuss.' : 'Add a little more detail (at least 10 characters).'),
  };

  const form = document.querySelector<HTMLFormElement>('[data-testid="contact-form"]');
  if (form) {
    const fields = Array.from(form.querySelectorAll<Field>('input:not([type="hidden"]), textarea'));
    const errorFor = (f: Field) => document.getElementById(`${f.id}-error`);

    const showError = (f: Field) => {
      const err = errorFor(f);
      f.setAttribute('aria-invalid', 'true');
      if (err) {
        err.textContent = MESSAGES[f.id]?.(f) ?? f.validationMessage;
        err.classList.remove('hidden');
      }
    };
    const clearError = (f: Field) => {
      f.removeAttribute('aria-invalid');
      errorFor(f)?.classList.add('hidden');
    };

    fields.forEach((f) => {
      f.addEventListener('invalid', () => showError(f));
      // Once a field has been flagged, re-check it as the visitor types.
      f.addEventListener('input', () => {
        if (!f.hasAttribute('aria-invalid')) return;
        if (f.validity.valid) clearError(f);
        else showError(f);
      });
    });

    form.addEventListener('submit', (e) => {
      // checkValidity() fires `invalid` on every failing field, which shows its message.
      if (!form.checkValidity()) {
        e.preventDefault();
        fields.find((f) => !f.validity.valid)?.focus();
        return;
      }
      setSending(true);
    });

    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const idleLabel = submit?.textContent?.trim() ?? '';
    function setSending(sending: boolean) {
      if (!submit) return;
      submit.disabled = sending;
      submit.textContent = sending ? 'Sending…' : idleLabel;
    }
    // Coming back from Formspree via the back button restores this page from the cache; re-enable the button.
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) setSending(false);
    });
  }
</script>
