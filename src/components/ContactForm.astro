---
import Button from './Button.astro';
import { CONTACT_CONTENT, EMAIL_ADDRESS, SITE_URL } from '../data/site';
const FORMSPREE_ENDPOINT = "https://formspree.io/f/xzdyblya";

const FIELD =
  'w-full bg-card border border-edge rounded px-4 py-3 text-sm text-lightest-slate placeholder-slate-text transition-colors duration-250 focus:border-green-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-green-accent/50 aria-[invalid=true]:border-danger';
const LABEL = 'block font-mono text-xs text-light-slate mb-1.5';
const ERROR = 'hidden font-mono text-xs text-danger mt-1.5';
---

<!-- Without JavaScript the browser checks the fields, the form posts to Formspree, and Formspree redirects to
     /contact/thanks/. With JavaScript the script below turns off the browser's bubbles (inline errors instead),
     submits with fetch and reports Formspree's actual answer in the status regions, so success is shown only
     after a real delivery. -->
<div
  id="contact-success"
  role="status"
  aria-live="polite"
  data-testid="contact-form-success"
  class="hidden mb-8 rounded-xl border border-green-accent/40 bg-card p-6 text-left font-mono text-sm text-green-accent"
></div>
<form
  action={FORMSPREE_ENDPOINT}
  method="POST"
  data-testid="contact-form"
  data-state="idle"
  data-success={CONTACT_CONTENT.success}
  data-fallback-email={EMAIL_ADDRESS}
  class="w-full max-w-lg text-left mb-8 space-y-5"
>
  <div>
    <label for="contact-name" class={LABEL}>Name</label>
    <input
      type="text"
      id="contact-name"
      name="name"
      required
      autocomplete="name"
      minlength="2"
      pattern=".{2,}"
      data-testid="contact-field-name"
      aria-describedby="contact-name-error"
      aria-errormessage="contact-name-error"
      class={FIELD}
      placeholder="Your name"
    />
    <p id="contact-name-error" role="alert" class={ERROR}></p>
  </div>
  <div>
    <label for="contact-email" class={LABEL}>Email</label>
    <input
      type="email"
      id="contact-email"
      name="email"
      required
      autocomplete="email"
      data-testid="contact-field-email"
      aria-describedby="contact-email-error"
      aria-errormessage="contact-email-error"
      class={FIELD}
      placeholder="your@email.com"
    />
    <p id="contact-email-error" role="alert" class={ERROR}></p>
  </div>
  <div>
    <label for="contact-message" class={LABEL}>Message</label>
    <textarea
      id="contact-message"
      name="message"
      required
      rows="5"
      minlength="10"
      data-testid="contact-field-message"
      aria-describedby="contact-message-error"
      aria-errormessage="contact-message-error"
      class={`${FIELD} resize-y`}
      placeholder="What would you like to discuss?"
    ></textarea>
    <p id="contact-message-error" role="alert" class={ERROR}></p>
  </div>
  <!-- No-JS path only: Formspree redirects here after a successful post (it expects an absolute URL). -->
  <input type="hidden" name="_next" value={`${SITE_URL}/contact/thanks/`} />
  <p id="contact-form-error" role="alert" data-testid="contact-form-error" class="hidden rounded border border-danger/50 p-3 font-mono text-xs text-danger"></p>
  <div class="text-center pt-2">
    <Button type="submit" size="lg" data-testid="contact-form-submit">Send Message</Button>
  </div>
</form>

<script>
  type Field = HTMLInputElement | HTMLTextAreaElement;

  // Each message names the problem and how to fix it.
  const MESSAGES: Record<string, (f: Field) => string> = {
    'contact-name': (f) => (f.validity.valueMissing ? 'Enter your name.' : 'Your name needs at least 2 characters.'),
    'contact-email': (f) => (f.validity.valueMissing ? 'Enter your email address.' : 'Enter a valid email address, like name@example.com.'),
    'contact-message': (f) => (f.validity.valueMissing ? 'Tell me what you would like to discuss.' : 'Add a little more detail (at least 10 characters).'),
  };

  const form = document.querySelector<HTMLFormElement>('[data-testid="contact-form"]');
  if (form) {
    // The script reports errors inline, so the browser's own bubbles are turned off only now.
    form.noValidate = true;
    const fields = Array.from(form.querySelectorAll<Field>('input:not([type="hidden"]), textarea'));
    const errorFor = (f: Field) => document.getElementById(`${f.id}-error`);

    const showError = (f: Field) => {
      const err = errorFor(f);
      f.setAttribute('aria-invalid', 'true');
      if (err) {
        err.textContent = MESSAGES[f.id]?.(f) ?? f.validationMessage;
        err.classList.remove('hidden');
      }
    };
    const clearError = (f: Field) => {
      f.removeAttribute('aria-invalid');
      errorFor(f)?.classList.add('hidden');
    };

    fields.forEach((f) => {
      f.addEventListener('invalid', () => showError(f));
      // Once a field has been flagged, re-check it as the visitor types.
      f.addEventListener('input', () => {
        if (!f.hasAttribute('aria-invalid')) return;
        if (f.validity.valid) clearError(f);
        else showError(f);
      });
    });

    const success = document.getElementById('contact-success');
    const formError = document.getElementById('contact-form-error');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const idleLabel = submit?.textContent?.trim() ?? '';
    const setState = (state: 'idle' | 'sending' | 'sent' | 'error') => {
      form.dataset.state = state;
      if (submit) {
        submit.disabled = state === 'sending';
        submit.textContent = state === 'sending' ? 'Sending…' : idleLabel;
      }
    };
    const showFormError = (message: string) => {
      if (!formError) return;
      formError.textContent = `${message} You can also email ${form.dataset.fallbackEmail}.`;
      formError.classList.remove('hidden');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      formError?.classList.add('hidden');
      // checkValidity() fires `invalid` on every failing field, which shows its message.
      if (!form.checkValidity()) {
        fields.find((f) => !f.validity.valid)?.focus();
        return;
      }
      setState('sending');
      try {
        // Formspree answers JSON when asked: { ok: true } on delivery, { errors: [{ field, message }] } otherwise.
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const body = await res.json().catch(() => ({}));
        if (!res.ok || body.ok === false) {
          const errors: Array<{ field?: string; message: string }> = body.errors ?? [];
          const sentence = (m: string) => (/[.!?]$/.test(m) ? m : `${m}.`);
          throw new Error(errors.map((x) => sentence(x.message)).join(' ') || `The message could not be sent (HTTP ${res.status}).`);
        }
        const email = (form.elements.namedItem('email') as HTMLInputElement).value;
        const sentAt = new Date();
        setState('sent');
        if (success) {
          success.replaceChildren(
            Object.assign(document.createElement('p'), { textContent: form.dataset.success ?? '' }),
            Object.assign(document.createElement('p'), {
              className: 'mt-2 text-slate-text',
              textContent: `Delivered at ${sentAt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}. The reply will go to ${email}.`,
            }),
          );
          success.dataset.sentAt = sentAt.toISOString();
          success.classList.remove('hidden');
        }
        form.reset();
        form.classList.add('hidden');
      } catch (err) {
        setState('error');
        showFormError(err instanceof TypeError ? 'The message could not be sent: the network request failed.' : (err as Error).message);
      }
    });
  }
</script>
