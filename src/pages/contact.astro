---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import Button from '../components/Button.astro';
import { CONTACT_CONTENT, EMAIL_ADDRESS, ENGINEER_NAME } from '../data/site';
import { PERSON_REF, webPageJsonLd } from '../lib/jsonld';
import Breadcrumb from '../components/Breadcrumb.astro';
import { PAGE_MAIN } from '../lib/layout';
import { PAGE_TITLE } from '../lib/text-styles';

const jsonLd = [
  webPageJsonLd('/contact/', 'ContactPage', { "name": `Contact ${ENGINEER_NAME}`, "about": PERSON_REF, "mainEntity": PERSON_REF })
];
---

<BaseLayout
  title={`Contact | ${ENGINEER_NAME}`}
  description={`Get in touch with ${ENGINEER_NAME} about enterprise AI agents, consulting or open-source collaboration.`}
  jsonLd={jsonLd}
>
  <Header />
  <main id="main-content" class={PAGE_MAIN}>
    <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Contact" }]} />
    <div class="text-center max-w-xl mx-auto">
      <h1 id="whats-next" class={`${PAGE_TITLE} mb-4`}>{CONTACT_CONTENT.title}</h1>
      <p class="text-slate-text text-lg leading-relaxed mb-10">{CONTACT_CONTENT.paragraph}</p>

      <ContactForm />

      <p class="font-mono text-xs text-slate-text mb-4 mt-8">or email directly</p>
      <Button href={`mailto:${EMAIL_ADDRESS}`} size="md" data-testid="contact-cta" variant="secondary">
        {CONTACT_CONTENT.buttonText}
      </Button>
    </div>
  </main>
  <Footer />
</BaseLayout>
