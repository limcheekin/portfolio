---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import { ENGINEER_NAME, SITE_URL } from '../data/site';
import { GUTTER } from '../lib/layout';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Page Not Found",
    "description": "The requested page does not exist. Use the navigation below to find what you're looking for.",
    "url": `${SITE_URL}/404.html`,
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_URL }
      ]
    }
  }
];
---

<BaseLayout title={`Page Not Found | ${ENGINEER_NAME}`} description="The page you're looking for doesn't exist." jsonLd={jsonLd}>
  <Header />
  <main id="main-content" class={`mx-auto flex min-h-screen max-w-screen-lg flex-col items-center justify-center text-center ${GUTTER}`}>
    <h1 class="mb-4 text-6xl font-semibold tracking-[-0.03em] text-green-accent md:text-8xl">404</h1>
    <h2 class="mb-6 text-2xl font-semibold tracking-[-0.02em] text-lightest-slate md:text-3xl">Page Not Found</h2>
    <p class="text-slate-text text-lg mb-10 max-w-md">
      The page you're looking for doesn't exist or has been moved. Here are some places you can go instead:
    </p>
    <div class="flex flex-wrap gap-4 justify-center">
      <Button href="/">Home</Button>
      <Button href="/projects/" variant="secondary">Projects</Button>
      <Button href="/insights/" variant="secondary">Writing</Button>
      <Button href="/contact/" variant="secondary">Contact</Button>
    </div>
  </main>
  <Footer />
</BaseLayout>
