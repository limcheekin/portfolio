---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { CONTACT_CONTENT, ENGINEER_NAME } from '../../data/site';
import { PAGE_MAIN } from '../../lib/layout';
import { PAGE_TITLE } from '../../lib/text-styles';

// Where Formspree sends visitors who submitted the contact form without JavaScript (the form's _next field).
// Formspree redirects here only after accepting a submission; with JavaScript the form reports the result
// in place and never comes here. Not indexed, and left out of the sitemap.
---

<BaseLayout title={`Message sent | ${ENGINEER_NAME}`} description="Confirmation page after sending the contact form." noindex>
  <Header />
  <main id="main-content" class={PAGE_MAIN}>
    <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Contact", href: "/contact/" }, { label: "Message sent" }]} />
    <div class="text-center max-w-xl mx-auto">
      <h1 id="message-sent" class={`${PAGE_TITLE} mb-4`}>Message sent</h1>
      <p role="status" data-testid="contact-thanks" class="text-slate-text text-lg leading-relaxed mb-10">{CONTACT_CONTENT.success}</p>
      <Button href="/" data-testid="contact-thanks-home">Back to the home page</Button>
    </div>
  </main>
  <Footer />
</BaseLayout>
