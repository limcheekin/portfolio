---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { ENGINEER_NAME, SITE_TITLE, SITE_URL, ENGINEER_TITLE } from '../data/site';
import Hero from '../components/home/Hero.astro';
import WorkTrack from '../components/home/WorkTrack.tsx';
import CareerTimeline from '../components/home/CareerTimeline.tsx';
import LatestWriting from '../components/home/LatestWriting.astro';
import McpServers from '../components/home/McpServers.astro';
import ContactCta from '../components/home/ContactCta.astro';
import { CAREER_INTRO, getCareerEntries } from '../data/career';
import type { WorkCard } from '../components/home/types';
import { projectJsonLd } from '../lib/project-jsonld';
import { PERSON_REF, WEBSITE_ID, webPageJsonLd } from '../lib/jsonld';
import { personJsonLd } from '../lib/person-jsonld';
import { projectLabel } from '../lib/project-kind';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.featuredOrder ?? 99) - (b.data.featuredOrder ?? 99));

// Short names (before the colon) of the projects the "All projects" card mentions.
const shortTitle = (p: (typeof allProjects)[number]) => p.data.title.split(':')[0].trim();
const MORE_CARD_SLUGS = ['open-text-embeddings', 'smart-hvac-catalogue', 'fluwix', 'talking-book'];
const moreCardNames = MORE_CARD_SLUGS.map((slug) => {
  const p = allProjects.find((x) => x.slug === slug);
  if (!p) throw new Error(`index.astro: no project "${slug}" for the All projects card`);
  return shortTitle(p);
});

const workCards: WorkCard[] = [
  ...featuredProjects.map((p): WorkCard => {
    const { kind, org } = p.data;
    return {
      slug: p.slug,
      title: shortTitle(p),
      kind,
      label: projectLabel(kind, org),
      tagline: p.data.tagline ?? p.data.description,
      stack: p.data.stack ?? [],
      visual: p.data.visual,
      href: `/projects/${p.slug}/`,
    };
  }),
  { slug: 'all-projects', title: 'All projects →', kind: 'more', label: 'More', tagline: `${moreCardNames.join(', ')} and more.`, stack: [], href: '/projects/' },
];

const careerEntries = await getCareerEntries();

const recentArticles = (await getCollection('articles'))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const jsonLd = [
  await personJsonLd(),
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": WEBSITE_ID,
    "name": `${ENGINEER_NAME} - Portfolio`,
    "url": `${SITE_URL}/`,
    "description": `Personal portfolio for ${ENGINEER_NAME}, an ${ENGINEER_TITLE}`,
    "inLanguage": "en",
    "author": PERSON_REF,
    "publisher": PERSON_REF,
    "potentialAction": {
      "@type": "ReadAction",
      "target": [
        `${SITE_URL}/api/portfolio.json`,
        `${SITE_URL}/llms-full.txt`
      ]
    }
  },
  webPageJsonLd('/', 'WebPage', { "name": SITE_TITLE, "about": PERSON_REF }),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": `Featured Projects by ${ENGINEER_NAME}`,
    "itemListElement": featuredProjects.map((p, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "item": projectJsonLd(p)
    }))
  }
];
---

<BaseLayout jsonLd={jsonLd} smoothScroll>
  <Header />

  <main id="main-content" data-testid="main-content" class="min-h-screen">

    <Hero />

    <WorkTrack client:load cards={workCards} />

    <CareerTimeline client:load intro={CAREER_INTRO} entries={careerEntries} />

    <LatestWriting articles={recentArticles} />

    <McpServers />

    <ContactCta />

  </main>

  <Footer />
</BaseLayout>
