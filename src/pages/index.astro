---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import {
  HERO_CONTENT, CONTACT_CTA,
  EMAIL_ADDRESS, ENGINEER_NAME, SITE_URL, ENGINEER_TITLE,
} from '../data/site';
import type { WorkCard } from '../components/home/types';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.featuredOrder ?? 99) - (b.data.featuredOrder ?? 99));

const workCards: WorkCard[] = [
  ...featuredProjects.map((p): WorkCard => ({
    slug: p.slug,
    title: p.data.title.split(':')[0].trim(),
    kind: p.data.kind === 'oss' ? 'oss' : 'enterprise',
    label: p.data.kind === 'oss' ? 'Open source' : 'Enterprise · Daxonet AI',
    tagline: p.data.tagline,
    stack: p.data.stack,
    visual: p.data.visual,
    href: `/projects/${p.slug}/`,
  })),
  { slug: 'all-projects', title: 'All projects →', kind: 'more', label: 'More', tagline: 'open-text-embeddings, Smart HVAC RAG, Fluwix, Talking Book and more.', stack: [], href: '/projects/' },
];

const recentArticles = (await getCollection('articles'))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": ENGINEER_NAME,
    "url": SITE_URL,
    "image": `${SITE_URL}/images/profile.png`,
    "jobTitle": ENGINEER_TITLE,
    "description": `${ENGINEER_TITLE} focused on enterprise AI, conversational agents and business workflow integration.`,
    "email": `mailto:${EMAIL_ADDRESS}`,
    "knowsAbout": [
      "Artificial Intelligence", "Machine Learning", "Retrieval-Augmented Generation",
      "LLM Deployment", "Python", "Java", "Spring", "React", "TypeScript",
      "MongoDB", "PostgreSQL", "AWS", "Docker", "Model Context Protocol"
    ],
    "worksFor": { "@type": "Organization", "name": "Daxonet AI Sdn. Bhd." },
    "alumniOf": [
      { "@type": "Organization", "name": "DXC Technology", "url": "https://www.dxc.com" },
      { "@type": "Organization", "name": "Zurich Technology Services Malaysia" },
      { "@type": "Organization", "name": "Penril Datability Networks" },
      { "@type": "Organization", "name": "Siemens Multimedia" }
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "email": EMAIL_ADDRESS,
      "contactType": "professional inquiry",
      "availableLanguage": ["English"]
    },
    "sameAs": [
      "https://github.com/limcheekin",
      "https://linkedin.com/in/limcheekin",
      "https://medium.com/@limcheekin"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": `${ENGINEER_NAME} - Portfolio`,
    "url": SITE_URL,
    "description": `Personal portfolio for ${ENGINEER_NAME}, a ${ENGINEER_TITLE}`,
    "author": { "@type": "Person", "name": ENGINEER_NAME },
    "potentialAction": {
      "@type": "ReadAction",
      "target": [
        `${SITE_URL}/api/portfolio.json`,
        `${SITE_URL}/llms-full.txt`
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What does Lim Chee Kin specialize in?",
        "url": `${SITE_URL}/about/`,
        "acceptedAnswer": { "@type": "Answer", "text": "Lim Chee Kin specializes in enterprise AI and solution architecture. His current focus areas include conversational agents, multimodal document extraction, Retrieval-Augmented Generation (RAG), real-time voice AI, and integration with accounting and business platforms through role-restricted MCP tools." }
      },
      {
        "@type": "Question",
        "name": "What is RAG.WTF?",
        "url": `${SITE_URL}/projects/rag-wtf/`,
        "acceptedAnswer": { "@type": "Answer", "text": "RAG.WTF is an open-source platform for private, personalized knowledge discovery and management using Retrieval-Augmented Generation (RAG) systems." }
      },
      {
        "@type": "Question",
        "name": "What is Project Concord?",
        "url": `${SITE_URL}/projects/`,
        "acceptedAnswer": { "@type": "Answer", "text": "Project Concord is a Model Context Protocol (MCP) server that connects modern AI agents with legacy database schemas." }
      },
      {
        "@type": "Question",
        "name": "How can I contact Lim Chee Kin?",
        "url": `${SITE_URL}/contact/`,
        "acceptedAnswer": { "@type": "Answer", "text": "You can reach Lim Chee Kin via email at limcheekin@vobject.com, through LinkedIn at linkedin.com/in/limcheekin, or via GitHub at github.com/limcheekin." }
      },
      {
        "@type": "Question",
        "name": "What technologies does Lim Chee Kin work with?",
        "url": `${SITE_URL}/about/`,
        "acceptedAnswer": { "@type": "Answer", "text": "Lim Chee Kin works with Python, TypeScript, Java, FastAPI, React and Next.js for application development. For AI, he uses the Claude Agent SDK, Google Gemini, the Model Context Protocol (MCP), Pipecat for voice, hybrid retrieval, and Ragas for LLM evaluation. His infrastructure stack includes Docker, Kubernetes, AWS, GCP/GKE, PostgreSQL/pgvector, MongoDB Atlas, and SurrealDB." }
      },
      {
        "@type": "Question",
        "name": "What is Lim Chee Kin's approach to data sovereignty and private AI?",
        "url": `${SITE_URL}/about/`,
        "acceptedAnswer": { "@type": "Answer", "text": "Lim Chee Kin advocates for data ownership and privacy through self-hosted AI infrastructure. He runs local LLMs, embeddings, and STT/TTS services on dedicated hardware (OrangePi 5 Max with Docker and Coolify), and integrates embedded databases like SurrealDB.wasm for client-side data sovereignty." }
      },
      {
        "@type": "Question",
        "name": "What is open-text-embeddings?",
        "url": `${SITE_URL}/projects/open-text-embeddings/`,
        "acceptedAnswer": { "@type": "Answer", "text": "open-text-embeddings is a Python library created by Lim Chee Kin that provides an OpenAI-compatible API for diverse open-source sentence transformer models such as BGE and E5. It enables significant cost reduction and eliminates vendor lock-in for text embedding generation in RAG and NLP applications." }
      },
      {
        "@type": "Question",
        "name": "Is Lim Chee Kin available for freelance or consulting work?",
        "url": `${SITE_URL}/contact/`,
        "acceptedAnswer": { "@type": "Answer", "text": "Lim Chee Kin is open to AI engineering consulting, solution architecture engagements, and collaborations on open-source AI projects. He is particularly interested in RAG systems, local LLM deployment, data sovereignty solutions, and AI agent infrastructure. Reach out via email at limcheekin@vobject.com or LinkedIn." }
      },
      {
        "@type": "Question",
        "name": "What is Talk To AI?",
        "url": `${SITE_URL}/projects/talk-to-ai/`,
        "acceptedAnswer": { "@type": "Answer", "text": "Talk To AI is a real-time voice AI application built by Lim Chee Kin that achieves sub-300ms latency for voice interactions. It supports local and cloud-based speech-to-text (STT), large language model (LLM), and text-to-speech (TTS) services via FastRTC, enabling private, low-latency voice conversations with AI." }
      },
      {
        "@type": "Question",
        "name": "What is Lim Chee Kin's career background?",
        "url": `${SITE_URL}/about/#work-experience`,
        "acceptedAnswer": { "@type": "Answer", "text": "Lim Chee Kin started his software career in 1999. He led enterprise Java teams at DXC Technology and Zurich Technology Services, delivered banking and healthcare systems, built 10+ open-source Grails plugins, worked as an independent Principal AI Architect from 2021 to 2025, and joined Daxonet AI as AI Solutions Architect in 2026." }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": `Featured Projects by ${ENGINEER_NAME}`,
    "itemListElement": featuredProjects.map((p, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "item": {
        "@type": "SoftwareSourceCode",
        "name": p.data.title,
        "description": p.data.description,
        "codeRepository": p.data.githubUrl,
        "programmingLanguage": p.data.technologies,
        "author": { "@type": "Person", "name": ENGINEER_NAME },
        "keywords": p.data.technologies.join(', ')
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_URL }
    ]
  }
];
---

<BaseLayout jsonLd={jsonLd}>
  <a href="#main-content" class="absolute left-[-9999px] top-auto w-px h-px overflow-hidden focus:static focus:w-auto focus:h-auto focus:p-3 focus:m-3 focus:block focus:bg-green-accent focus:text-navy rounded-md shadow-lg z-[9999]">
    Skip to main content
  </a>

  <Header />

  <main id="main-content" data-testid="main-content" class="min-h-screen">

    <section id="hero" data-testid="hero-section" class="px-6 sm:px-10 md:px-16 lg:px-24 pt-32 pb-20">
      <p class="font-mono text-green-accent mb-4">{HERO_CONTENT.eyebrow}</p>
      <h1 class="text-4xl md:text-6xl font-display font-bold text-lightest-slate mb-4">
        {HERO_CONTENT.headline.before}<em class="not-italic text-green-accent">{HERO_CONTENT.headline.accent}</em>{HERO_CONTENT.headline.after}
      </h1>
      <p class="text-slate-text text-lg mb-8">{HERO_CONTENT.sub}</p>
      <div class="flex gap-4">
        <a href={HERO_CONTENT.primaryCta.href} data-testid="hero-cta" class="text-green-accent">{HERO_CONTENT.primaryCta.label}</a>
        <a href={HERO_CONTENT.resumeCta.href} class="text-slate-text">{HERO_CONTENT.resumeCta.label}</a>
      </div>
    </section>

    <section id="work" class="px-6 sm:px-10 md:px-16 lg:px-24 py-20">
      <ul class="space-y-3">
        {workCards.map((card) => (
          <li>
            <a href={card.href} class="text-lightest-slate">{card.title}</a>
            <span class="text-slate-text"> {card.tagline}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="career" class="px-6 sm:px-10 md:px-16 lg:px-24 py-20">
      <a href="/about/" class="text-green-accent">Career and background</a>
    </section>

    <section id="writing" class="px-6 sm:px-10 md:px-16 lg:px-24 py-20">
      <ul class="space-y-2">
        {recentArticles.map((article) => (
          <li class="text-lightest-slate">{article.data.title}</li>
        ))}
      </ul>
    </section>

    <section id="contact" class="px-6 sm:px-10 md:px-16 lg:px-24 py-20">
      <p class="font-mono text-green-accent mb-4">{CONTACT_CTA.eyebrow}</p>
      <h2 class="text-3xl md:text-4xl font-semibold text-lightest-slate mb-4">
        {CONTACT_CTA.headline.before}<em class="not-italic text-green-accent">{CONTACT_CTA.headline.accent}</em>
      </h2>
      <p class="text-slate-text text-lg mb-8">{CONTACT_CTA.paragraph}</p>
      <a href={CONTACT_CTA.button.href} data-testid="hero-contact-cta" class="text-green-accent">{CONTACT_CTA.button.label}</a>
    </section>

  </main>

  <Footer />
</BaseLayout>
