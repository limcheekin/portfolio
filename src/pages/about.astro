---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { ABOUT_CONTENT, ENGINEER_NAME, SITE_URL } from '../data/site';
import { FAQ } from '../data/faq';
import { markdownPath } from '../lib/paths';
import Img from '../components/Img.astro';
import { PAGE_MAIN } from '../lib/layout';
import { CHIP, MEASURE, PAGE_TITLE } from '../lib/text-styles';
import { PERSON_REF, webPageJsonLd } from '../lib/jsonld';
import { personJsonLd } from '../lib/person-jsonld';

const experience = (await getCollection('experience'))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const jsonLd = [
  await personJsonLd(),
  webPageJsonLd('/about/', 'ProfilePage', { "name": `About ${ENGINEER_NAME}`, "mainEntity": PERSON_REF }),
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${SITE_URL}/about/#faq`,
    "mainEntity": FAQ.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "url": `${SITE_URL}${f.path}`,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  }
];
---

<BaseLayout
  title={`About | ${ENGINEER_NAME}`}
  markdownUrl={markdownPath('/about/')}
  description={`Learn about ${ENGINEER_NAME}'s career in enterprise software, AI engineering and solution architecture.`}
  jsonLd={jsonLd}
>
  <Header />
  <main id="main-content" class={PAGE_MAIN}>
    <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "About" }]} />
    <h1 id="about-me" class={`${PAGE_TITLE} mb-8`}>About {ENGINEER_NAME}</h1>

    <div class="grid md:grid-cols-5 gap-10 lg:gap-12 items-start mb-20">
      <div class="md:col-span-3">
        {ABOUT_CONTENT.introductionParagraphs.map((paragraph) => (
          <p class={`text-slate-text text-lg leading-relaxed mb-4 ${MEASURE}`}>{paragraph}</p>
        ))}
        <h2 class="mt-8 mb-3 text-lightest-slate">Technologies I work with</h2>
        <ul class="flex list-none flex-wrap gap-2 p-0">
          {ABOUT_CONTENT.skills.map((skill) => (
            <li class={CHIP}>{skill}</li>
          ))}
        </ul>
      </div>
      <div class="md:col-span-2 mx-auto w-full max-w-xs md:mx-0 md:max-w-sm">
        <Img
          src={ABOUT_CONTENT.professionalPhotoUrl}
          alt={`Professional headshot of ${ENGINEER_NAME}`}
          class="h-auto w-full rounded-2xl border border-edge object-cover"
          loading="eager"
        />
      </div>
    </div>

    <h2 id="work-experience" class="mb-10 text-[clamp(24px,3vw,32px)] font-semibold tracking-[-0.03em] text-lightest-slate">
      Work Experience
    </h2>

    <ExperienceTimeline entries={experience} />

    <section aria-labelledby="faq" class="mt-24">
      <h2 id="faq" class="mb-10 text-[clamp(24px,3vw,32px)] font-semibold tracking-[-0.03em] text-lightest-slate">
        Frequently asked questions
      </h2>
      <dl class={`m-0 ${MEASURE} space-y-8`} data-testid="faq">
        {FAQ.map((f) => (
          <div data-testid="faq-entry">
            <dt class="text-lg font-semibold text-lightest-slate">{f.question}</dt>
            <dd class="m-0 mt-2 leading-relaxed text-slate-text">{f.answer}</dd>
          </div>
        ))}
      </dl>
    </section>
  </main>
  <Footer />
</BaseLayout>
