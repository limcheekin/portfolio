---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { PAGE_MAIN } from '../../lib/layout';
import { CHIP, MEASURE, PAGE_TITLE } from '../../lib/text-styles';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import { getCollection } from 'astro:content';
import { ENGINEER_NAME, SITE_URL } from '../../data/site';
import { PERSON_REF, WEBSITE_ID } from '../../lib/jsonld';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();

// The page summarises an article whose full text lives on Medium: the Article is this page's main entity,
// and sameAs points at the original.
const pageUrl = `${SITE_URL}/insights/${article.slug}/`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    "headline": article.data.title,
    "description": article.data.description,
    "url": pageUrl,
    "mainEntityOfPage": { "@id": `${pageUrl}#webpage` },
    ...(article.data.externalUrl && { "sameAs": article.data.externalUrl }),
    "datePublished": article.data.publishDate.toISOString(),
    "author": PERSON_REF,
    "publisher": PERSON_REF,
    "keywords": article.data.tags.join(', ')
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    "url": pageUrl,
    "isPartOf": { "@id": WEBSITE_ID },
    "mainEntity": { "@id": `${pageUrl}#article` },
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": ["#article-title", ".prose-like"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_URL },
      { "@type": "ListItem", "position": 2, "name": "Writing", "item": `${SITE_URL}/insights/` },
      { "@type": "ListItem", "position": 3, "name": article.data.title, "item": `${SITE_URL}/insights/${article.slug}/` }
    ]
  }
];
---

<BaseLayout
  title={`${article.data.title} | ${ENGINEER_NAME}`}
  description={article.data.description}
  jsonLd={jsonLd}
>
  <Header />
  <main id="main-content" class={PAGE_MAIN}>
    <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Writing", href: "/insights/" }, { label: article.data.title }]} />

    <article aria-labelledby="article-title">
      <h1 id="article-title" class={`${PAGE_TITLE} mb-4`}>{article.data.title}</h1>

      <div class="flex items-center gap-4 mb-8 font-mono text-sm text-slate-text">
        <time datetime={article.data.publishDate.toISOString()}>
          {article.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {article.data.platform && <span>· {article.data.platform}</span>}
      </div>

      <ul class="mb-8 flex list-none flex-wrap gap-2 p-0">
        {article.data.tags.map((tag) => (
          <li class={CHIP}>{tag}</li>
        ))}
      </ul>

      {article.data.externalUrl && (
        <div class="mb-8 rounded-xl border border-edge bg-card p-4">
          <p class="text-sm text-slate-text">
            This article was originally published on an external platform.
            <a href={article.data.externalUrl} target="_blank" rel="noopener noreferrer" class="text-green-accent hover:underline ml-1">
              Read the full article &rarr;<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </p>
        </div>
      )}

      <div class={`prose-like ${MEASURE} space-y-4 text-base leading-relaxed text-slate-text`}>
        <Content />
      </div>
    </article>

    <div class="mt-16">
      <Button href="/insights/" variant="secondary">&larr; All Articles</Button>
    </div>
  </main>
  <Footer />
</BaseLayout>
