---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { ENGINEER_NAME, SITE_URL } from '../../data/site';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { PAGE_MAIN } from '../../lib/layout';
import { PAGE_TITLE } from '../../lib/text-styles';
import { PERSON_REF } from '../../lib/jsonld';

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": `Articles by ${ENGINEER_NAME}`,
    "itemListElement": articles.map((a, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "item": {
        "@type": "Article",
        "@id": `${SITE_URL}/insights/${a.slug}/#article`,
        "name": a.data.title,
        "description": a.data.description,
        "url": `${SITE_URL}/insights/${a.slug}/`,
        ...(a.data.externalUrl && { "sameAs": a.data.externalUrl }),
        "datePublished": a.data.publishDate.toISOString(),
        "author": PERSON_REF
      }
    }))
  }
];
---

<BaseLayout
  title={`Writing | ${ENGINEER_NAME}`}
  description={`Articles and insights on AI engineering, RAG systems, and open-source AI by ${ENGINEER_NAME}.`}
  jsonLd={jsonLd}
>
  <Header />
  <main id="main-content" class={PAGE_MAIN}>
    <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Writing" }]} />
    <h1 id="writing-insights" class={`${PAGE_TITLE} mb-12`}>Writing</h1>
    <ul class="m-0 list-none border-t border-light-graphite p-0">
      {articles.map((article) => <ArticleRow article={article} detailed />)}
    </ul>
  </main>
  <Footer />
</BaseLayout>
