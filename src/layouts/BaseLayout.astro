---
import '@fontsource-variable/inter/wght.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { SITE_TITLE, SITE_URL, ENGINEER_NAME, ENGINEER_TITLE } from '../data/site';
import { webMcpTools } from '../lib/portfolio-tools';
import WebMCPTools from '../components/WebMCPTools.tsx';
import SmoothScroll from '../components/motion/SmoothScroll.tsx';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: object[];
  /** Lenis smooth scroll, driven by GSAP. Only the home page needs it (the pinned Work track and its
   *  scroll-linked pieces); reading pages scroll natively and ship no GSAP. */
  smoothScroll?: boolean;
  /** Error pages: no canonical URL, and ask indexers to skip the page. */
  noindex?: boolean;
}

const {
  title = SITE_TITLE,
  description = `Personal portfolio for ${ENGINEER_NAME}, an ${ENGINEER_TITLE}, showcasing skills, experience, and AI projects.`,
  ogImage = `${SITE_URL}/images/portfolio.png`,
  canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href,
  jsonLd = [],
  smoothScroll = false,
  noindex = false,
} = Astro.props;

// Derive current page identifier from pathname for data-current-page attribute
const pathSegments = Astro.url.pathname.replace(/^\/|\/$/g, '').split('/');
const currentPage = pathSegments[0] || 'home';
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={ENGINEER_NAME} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
  <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  {!noindex && <meta property="og:url" content={canonicalUrl} />}
  <meta property="og:type" content="website" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="alternate" type="application/rss+xml" title={`Writing by ${ENGINEER_NAME}`} href="/rss.xml" />

  {jsonLd.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body class="bg-navy text-lightest-slate antialiased selection:bg-green-accent/30 selection:text-green-accent" data-current-page={currentPage}>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:rounded-md focus:bg-green-accent focus:px-4 focus:py-3 focus:font-mono focus:text-sm focus:text-navy">
    Skip to main content
  </a>
  {smoothScroll && <SmoothScroll client:load />}
  <slot />
  <WebMCPTools client:idle portfolioApiUrl={`${SITE_URL}/api/portfolio.json`} tools={webMcpTools()} />
</body>
</html>
